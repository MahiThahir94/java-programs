import java.util.Scanner;

class SecurityCode {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt(), r, rev = 0, temp = n;
        while (n > 0) {
            r = n % 10;
            rev = rev * 10 + r;
            n = n / 10;
        }
        if (temp == rev)
            System.out.println("Valid code");
        else
            System.out.println("Invalid code");
    }
}

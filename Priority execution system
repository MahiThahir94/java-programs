class PriorityExecution extends Thread {
    public void run() {
        System.out.println("Running: " + getName());
    }
    public static void main(String[] args) {
        PriorityExecution t1 = new PriorityExecution();
        PriorityExecution t2 = new PriorityExecution();
        t1.setPriority(Thread.MAX_PRIORITY);
        t2.setPriority(Thread.MIN_PRIORITY);
        t1.start();
        t2.start();
    }
}

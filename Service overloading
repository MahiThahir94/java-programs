class ServiceOverloading {
    void add(int a, int b) {
        System.out.println("Sum: " + (a + b));
    }
    void add(double a, double b) {
        System.out.println("Sum: " + (a + b));
    }
    public static void main(String[] args) {
        ServiceOverloading obj = new ServiceOverloading();
        obj.add(5, 10);
        obj.add(2.5, 3.5);
    }
}

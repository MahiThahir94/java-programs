class TextFormatter {
    public static void main(String[] args) {
        String s = "Java is very easy";
        String result = "";
        for(int i = 0; i < s.length(); i++) {
            if(s.charAt(i) != ' ')
                result += s.charAt(i);
        }
        System.out.println("Without spaces: " + result);
    }
}
